rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /* -------------------------
       Helper Functions
    --------------------------*/
    function signedIn() {
      return request.auth != null;
    }

    function role() {
      return signedIn() ? request.auth.token.role : null;
    }

    function roleIs(r) {
      return signedIn() && role() == r;
    }

    function roleIn(list) {
      return signedIn() && (role() in list);
    }

    function roleFromProfile() {
      return signedIn()
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
        : null;
    }

    function resolvedRole() {
      return role() != null ? role() : roleFromProfile();
    }

    function resolvedRoleIn(list) {
      return signedIn() && (resolvedRole() in list);
    }

    function canManageSessions() {
      return resolvedRoleIn(["super_admin", "admin", "professor", "assistant", "prof"])
        // TODO: remove fallback once every user has a role stored.
        || (signedIn() && resolvedRole() == null);
    }

    function isProfessorOwner(profUid) {
      return signedIn() && request.auth.uid == profUid && roleIn(["professor", "prof"]);
    }

    /* -------------------------
       Users (Profiles)
       /users/{uid}
    --------------------------*/
    match /users/{uid} {

      // Any signed-in user can read their own profile
      allow read: if signedIn() && request.auth.uid == uid;

      // Super admin: full access
      allow read, create, update, delete: if roleIs("super_admin");

      // Admin: (as you wrote) allow read/write
      // NOTE: this is permissive. You can tighten later.
      allow read: if roleIs("admin");
      allow create: if roleIs("admin");
      allow update: if roleIs("admin");
      allow delete: if roleIs("admin");

      /* ----------------------------------------
         Subcollection inside each user:
         users/{uid}/profs/{profId}
         This is what your React should write to.
      -----------------------------------------*/
      match /profs/{profId} {

        // admin + super_admin can manage prof docs under a user
        allow read, create, update, delete: if roleIn(["super_admin", "admin"]);

        // OPTIONAL:
        // If you want the professor to read their own document too,
        // and you store profId == auth.uid
        // allow read: if roleIs("professor") && request.auth.uid == profId;
      }

      // (Optional) If later you want assistants under users:
      // match /assistants/{assistantId} {
      //   allow read, create, update, delete: if roleIn(["super_admin", "admin"]);
      // }
    }

    /* -------------------------
       Colleges (nested structure)
       /colleges/{collegeId}/years/{yearId}/departments/{deptId}/courses/{courseId}
    --------------------------*/
    match /colleges/{collegeId} {
      allow read: if signedIn();
      allow write: if roleIn(["super_admin", "admin"]);

      match /buildings/{buildingId} {
        allow read: if signedIn();
        allow write: if roleIn(["super_admin", "admin"]);

        match /rooms/{roomId} {
          allow read: if signedIn();
          allow write: if roleIn(["super_admin", "admin"]);

          match /schedule/{scheduleId} {
            allow read: if signedIn();
            allow write: if roleIn(["super_admin", "admin"]);
          }
        }
      }

      match /years/{yearId} {
        allow read: if signedIn();
        allow write: if roleIn(["super_admin", "admin"]);

        match /departments/{deptId} {
          allow read: if signedIn();
          allow write: if roleIn(["super_admin", "admin"]);

          match /courses/{courseId} {
            allow read: if signedIn();
            allow write: if roleIn(["super_admin", "admin"]);
          }
        }
      }
    }

    /* -------------------------
       TOP-LEVEL Collections
       /courses, /profs, /assistants
       (Keep them only if you still use them)
    --------------------------*/
    match /courses/{courseId} {
      allow read: if signedIn();
      allow create, update, delete: if roleIn(["super_admin", "admin"]);
    }

    match /allCourses/{courseId} {
      allow read: if signedIn();
      allow create, update, delete: if roleIn(["super_admin", "admin"]);
    }

    match /profs/{profId} {
      allow read: if roleIn(["super_admin", "admin"]);

      // if profId == auth.uid
      allow read: if roleIs("prof") && request.auth.uid == profId;

      allow create, update, delete: if roleIn(["super_admin", "admin"]);
    }

    match /assistants/{assistantId} {
      allow read: if roleIn(["super_admin", "admin"]);

      // if assistantId == auth.uid
      allow read: if roleIs("assistant") && request.auth.uid == assistantId;

      allow create, update, delete: if roleIn(["super_admin", "admin"]);
    }

    /* -------------------------
       Offerings (manual attendance)
       /offerings/{offeringId}
    --------------------------*/
    match /offerings/{offeringId} {
      allow read: if signedIn();
      allow create, update, delete: if resolvedRoleIn(["super_admin", "admin"]);
    }

    /* -------------------------
       Sessions
       /sessions/{sessionId}
    --------------------------*/
    match /sessions/{sessionId} {
      allow read: if signedIn();
      allow create, update, delete: if canManageSessions();
    }

    /* -------------------------
       Attendance (server-only writes)
       /attendance/{sessionId}_{studentId}
       /attendanceAgg_session/{sessionId}
    --------------------------*/
    match /attendance/{docId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /attendanceAgg_session/{sessionId} {
      allow read: if signedIn();
      allow write: if false;
    }

    /* -------------------------
       Engagement Aggregates (server-only writes)
       /engagementAgg/{sessionId}_{studentId}
    --------------------------*/
    match /engagementAgg/{docId} {
      allow read: if signedIn();
      allow write: if false;
    }

    /* -------------------------
       Course Assignments
       /courseAssignments/{assignmentId}
    --------------------------*/
    match /courseAssignments/{assignmentId} {

      allow read, create, update, delete: if roleIn(["super_admin", "admin"]);

      allow read: if signedIn()
        && (
          (roleIs("prof") && (request.auth.uid in resource.data.professorIds)) ||
          (roleIs("assistant") && (request.auth.uid in resource.data.assistantIds))
        );
    }

    /* -------------------------
       Professor/Assistant Indexes
       /prof_courses/{profUid}/courses/{assignmentId}
       /assistant_courses/{assistantUid}/courses/{assignmentId}
    --------------------------*/
    match /prof_courses/{profUid} {
      allow read: if signedIn()
        && (
          (request.auth.uid == profUid && roleIn(["professor", "prof"])) ||
          roleIn(["super_admin", "admin"])
        );
      allow write: if roleIn(["super_admin", "admin"]);

      match /courses/{assignmentId} {
        allow read: if signedIn()
          && (
            (request.auth.uid == profUid && roleIn(["professor", "prof"])) ||
            roleIn(["super_admin", "admin"])
          );
        allow write: if roleIn(["super_admin", "admin"]);

        match /materials/{materialId} {
          allow read: if isProfessorOwner(profUid);
          allow create: if isProfessorOwner(profUid)
            && request.resource.data.professorId == request.auth.uid;
          allow update, delete: if isProfessorOwner(profUid);
        }
      }
    }

    match /assistant_courses/{assistantUid} {
      allow read: if signedIn()
        && (
          (request.auth.uid == assistantUid && roleIs("assistant")) ||
          roleIn(["super_admin", "admin"])
        );
      allow write: if roleIn(["super_admin", "admin"]);

      match /courses/{assignmentId} {
        allow read: if signedIn()
          && (
            (request.auth.uid == assistantUid && roleIs("assistant")) ||
            roleIn(["super_admin", "admin"])
          );
        allow write: if roleIn(["super_admin", "admin"]);
      }
    }

    /* -------------------------
       Students
       /students/{studentId}
    --------------------------*/
    match /students/{studentId} {
      allow read: if roleIn(["super_admin", "admin", "prof", "assistant"])
        || (signedIn() && request.auth.uid == studentId);

      allow create, update, delete: if roleIn(["super_admin", "admin"]);
    }

    /* -------------------------
       Default DENY (important)
    --------------------------*/
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
